<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Launcher.Views.Settings"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonia="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        xmlns:c="using:Launcher.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:m="using:Launcher.Models"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Launcher.ViewModels"
        Title="{StaticResource Text.Settings}"
        Width="520"
        Height="400"
        MinWidth="520"
        MinHeight="400"
        d:DesignHeight="400"
        d:DesignWidth="520"
        x:DataType="vm:Settings"
        Background="{StaticResource Color.Window}"
        CanResize="False"
        Icon="/App.ico"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">

  <TabControl>
    <TabItem Header="{StaticResource Text.Settings}">

      <StackPanel Margin="14,10" Orientation="Vertical" Spacing="10">

        <!-- Launcher Music Checkbox -->
        <CheckBox Content="{StaticResource Text.Settings.General.MusicMuted}"
                  IsChecked="{Binding MusicMuted, Mode=TwoWay}"
                  ToolTip.Tip="{StaticResource Text.Settings.General.MusicMuted.Tooltip}" />

        <!-- Discord Activity Checkbox -->
        <CheckBox Content="{StaticResource Text.Settings.General.DiscordActivity}"
                  IsChecked="{Binding DiscordActivity, Mode=TwoWay}"
                  ToolTip.Tip="{StaticResource Text.Settings.General.DiscordActivity.Tooltip}" />

        <!-- Parallel Download Checkbox -->
        <CheckBox Content="{StaticResource Text.Settings.General.ParallelDownload}"
                  IsChecked="{Binding ParallelDownload, Mode=TwoWay}"
                  ToolTip.Tip="{StaticResource Text.Settings.General.ParallelDownload.Tooltip}" />

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" >

          <!-- Download Threads Label -->
          <TextBlock Grid.Row="0"
                     Grid.Column="0"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     FontSize="13"
                     Text="{StaticResource Text.Settings.General.ParallelDownloads}" />

          <!-- Download Threads NumericUpDown -->
          <avalonia:NumericUpDown Grid.Row="0"
                                  Grid.Column="1"
                                  Width="120"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  FormatString="F0"
                                  Maximum="{Binding MaxDownloadThreads}"
                                  Minimum="2"
                                  ToolTip.Tip="{StaticResource Text.Settings.General.ParallelDownloads.Tooltip}"
                                  Value="{Binding DownloadThreads, Mode=TwoWay}">

            <!-- TextBox Parallel Downloads (Readonly) -->
            <avalonia:NumericUpDown.Styles>
              <Style Selector="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="SelectionBrush" Value="Transparent" />
              </Style>

              <Style Selector="TextBox:pointerover">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="SelectionBrush" Value="Transparent" />
              </Style>

              <Style Selector="TextBox:focus-within">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="SelectionBrush" Value="Transparent" />
              </Style>
            </avalonia:NumericUpDown.Styles>
          </avalonia:NumericUpDown>

          <!-- Game Language -->
          <TextBlock Grid.Row="1"
                     Grid.Column="0"
                     Margin="0,10,10,0"
                     VerticalAlignment="Center"
                     FontSize="13"
                     Text="{StaticResource Text.Settings.General.Locale}" />

          <!-- Locale ComboBox -->
          <ComboBox Grid.Row="1"
                    Grid.Column="1"
                    Width="250"
                    Margin="0,10,0,0"
                    Padding="8,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    DisplayMemberBinding="{Binding Name, x:DataType=m:Locale}"
                    ItemsSource="{Binding Source={x:Static m:Locale.Locales}}"
                    SelectedItem="{Binding Locale, Mode=TwoWay, Converter={x:Static c:StringConverter.ToLocale}}"
                    ToolTip.Tip="{StaticResource Text.Settings.General.Locale.Tooltip}" />
        </Grid>

        <Rectangle Height="1"
                   Margin="0,4"
                   HorizontalAlignment="Stretch"
                   Fill="{StaticResource Color.Border}"
                   Opacity="0.5" />

        <!-- Install Location -->
        <StackPanel Orientation="Vertical" Spacing="6">

          <TextBlock FontSize="13"
                     FontWeight="SemiBold"
                     Text="{StaticResource Text.Settings.Install.Location}" />

          <Grid ColumnDefinitions="*,Auto,Auto">

            <TextBox Grid.Column="0"
                     VerticalAlignment="Center"
                     FontSize="12"
                     IsReadOnly="True"
                     Text="{Binding DisplayInstallPath, Mode=OneWay}"
                     ToolTip.Tip="{StaticResource Text.Settings.Install.Location.Tooltip}" />

            <Button Grid.Column="1"
                    Name="BrowseInstallPath"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Classes="flat primary"
                    Click="OnBrowseInstallPath"
                    Content="{StaticResource Text.Settings.Install.Browse}"
                    IsEnabled="{Binding !IsChangingInstallPath}" />

            <Button Grid.Column="2"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Classes="flat primary"
                    Command="{Binding OpenInstallPathCommand}"
                    ToolTip.Tip="{StaticResource Text.Settings.Install.Open}">
              <Path Width="14"
                    Height="14"
                    Data="{StaticResource Icons.Folder}"
                    Stretch="Fill" />
            </Button>
          </Grid>

          <CheckBox Content="{StaticResource Text.Settings.Install.MoveExisting}"
                    IsChecked="{Binding MoveExistingFiles, Mode=TwoWay}"
                    IsEnabled="{Binding !IsChangingInstallPath}"
                    ToolTip.Tip="{StaticResource Text.Settings.Install.MoveExisting.Tooltip}" />

          <TextBlock FontSize="12"
                     Opacity="0.7"
                     Text="{Binding InstallPathStatus, Mode=OneWay}" />
        </StackPanel>
      </StackPanel>
    </TabItem>
  </TabControl>
</Window>
