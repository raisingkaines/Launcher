<?xml version="1.0" encoding="UTF-8" ?>
<UserControl x:Class="Launcher.Views.Server"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:m="using:Launcher.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:vm="using:Launcher.ViewModels"
             d:DesignHeight="420"
             d:DesignWidth="800"
             x:DataType="vm:Server"
             mc:Ignorable="d">

  <Design.DataContext>
    <vm:Server />
  </Design.DataContext>

  <Grid RowDefinitions="*,Auto">

    <!-- Server News, hidden until asked for -->
    <Border Grid.Row="0"
            MinHeight="130"
            MaxHeight="250"
            Margin="56,6,56,12"
            VerticalAlignment="Stretch"
            Background="{StaticResource Color.Card}"
            BorderBrush="{StaticResource Color.Border}"
            BorderThickness="1"
            CornerRadius="10"
            IsVisible="{Binding IsNewsVisible}">

      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
          <Border Grid.ColumnSpan="2"
                  Background="{StaticResource Color.CardHeader}"
                  CornerRadius="10,10,0,0" />
          <TextBlock Grid.Column="0"
                     Margin="14,7"
                     FontFamily="{StaticResource FontDefault}"
                     FontSize="12"
                     Foreground="{StaticResource Color.Gold}"
                     LetterSpacing="1"
                     Text="{StaticResource Text.Server.News}" />
          <Button Grid.Column="1"
                  Width="22"
                  Height="22"
                  Margin="0,0,8,0"
                  Classes="rail small"
                  Command="{Binding ToggleNewsCommand}">
            <TextBlock FontSize="12" FontWeight="Bold" Foreground="White" Text="X" />
          </Button>
        </Grid>

        <ScrollViewer Padding="14,10" HorizontalScrollBarVisibility="Disabled">
          <md:MarkdownRenderer LinkCommand="{Binding OpenUriCommand}" MarkdownBuilder="{Binding MarkdownBuilder}" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Welcome Card -->
    <Border Grid.Row="1"
            Width="506"
            Margin="0,0,0,26"
            HorizontalAlignment="Center"
            Background="{StaticResource Color.Card}"
            BorderBrush="{StaticResource Color.Border}"
            BorderThickness="1"
            CornerRadius="10">

      <StackPanel Orientation="Vertical">

        <!-- Header -->
        <Border Padding="16,7"
                Background="{StaticResource Color.CardHeader}"
                CornerRadius="10,10,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       FontFamily="{StaticResource FontDefault}"
                       FontSize="14"
                       Foreground="{StaticResource Color.FG1}"
                       Text="{Binding Welcome, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="1"
                    Width="20"
                    Height="20"
                    Classes="rail small"
                    Command="{Binding ToggleNewsCommand}"
                    IsVisible="{Binding Info.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    ToolTip.Tip="{StaticResource Text.Server.News.Tooltip}">
              <Path Width="11"
                    Height="11"
                    Data="{StaticResource Icons.Logs}"
                    Stretch="Uniform" />
            </Button>
          </Grid>
        </Border>

        <!-- Status + Play -->
        <Grid Margin="18,12,14,12" ColumnDefinitions="*,Auto">

          <StackPanel Grid.Column="0"
                      VerticalAlignment="Center"
                      Orientation="Vertical"
                      Spacing="7">

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="10"
                       Height="10"
                       VerticalAlignment="Center"
                       Fill="{Binding ServerStatusFill}" />
              <TextBlock FontFamily="{StaticResource FontDefault}"
                         FontSize="14"
                         Foreground="{StaticResource Color.FG1}"
                         Text="{StaticResource Text.ServerStatus}" />
              <TextBlock FontFamily="{StaticResource FontDefault}"
                         FontSize="14"
                         Foreground="{Binding ServerStatusFill}"
                         Text="{Binding Status, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="10"
                       Height="10"
                       VerticalAlignment="Center"
                       Fill="{StaticResource Color.Gold}" />
              <TextBlock FontFamily="{StaticResource FontDefault}"
                         FontSize="14"
                         Foreground="{StaticResource Color.FG1}"
                         Text="{StaticResource Text.OnlinePlayers}" />
              <TextBlock FontFamily="{StaticResource FontDefault}"
                         FontSize="14"
                         Foreground="{StaticResource Color.FG1}"
                         Text="{Binding OnlinePlayers, Mode=OneWay}" />
            </StackPanel>
          </StackPanel>

          <!-- Play -->
          <Button Grid.Column="1"
                  VerticalAlignment="Center"
                  Classes="playimg"
                  Command="{Binding PlayCommand}"
                  Cursor="Hand"
                  IsEnabled="{Binding IsEnabled}"
                  IsVisible="{Binding PlayCommand.IsRunning, Converter={x:Static BoolConverters.Not}}">
            <Panel>
              <Image Width="166" Source="/Assets/play.png" Stretch="Uniform" />
              <Image Width="166"
                     Classes="hover"
                     Opacity="0"
                     Source="/Assets/play_hover.png"
                     Stretch="Uniform" />
            </Panel>
          </Button>

          <Border Grid.Column="1"
                  MinWidth="166"
                  Height="50"
                  IsVisible="{Binding PlayCommand.IsRunning}">
            <Path Width="24"
                  Height="24"
                  Classes="rotating"
                  Data="{StaticResource Icons.Loading}"
                  Stretch="Uniform" />
          </Border>
        </Grid>

        <!-- Download / launch progress -->
        <TextBlock Margin="18,0,18,11"
                   FontFamily="{StaticResource FontDefault}"
                   FontSize="12"
                   Foreground="{StaticResource Color.FG2}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding StatusMessage, Mode=OneWay}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
