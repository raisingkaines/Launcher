<?xml version="1.0" encoding="UTF-8" ?>
<Window x:Class="Launcher.Views.Main"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:m="using:Launcher.Models"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="using:Launcher.Views"
        xmlns:vm="using:Launcher.ViewModels"
        Title="{StaticResource Text.Title}"
        Width="1040"
        Height="560"
        MinWidth="1040"
        MinHeight="560"
        d:DesignHeight="560"
        d:DesignWidth="1040"
        x:DataType="vm:Main"
        Background="Transparent"
        CanResize="False"
        Icon="/App.ico"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">

  <Window.Styles>
    <!-- The rail opens only while the pointer is within its own bounds. -->
    <Style Selector="Image.backdrop">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:1.6" Easing="SineEaseInOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.serverRail">
      <Setter Property="Width" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Panel.railHost:pointerover Border.serverRail">
      <Setter Property="Width" Value="330" />
      <!-- Reads as floating over the artwork rather than pushing it aside. -->
      <Setter Property="BoxShadow" Value="6 0 18 0 #66000000" />
    </Style>

    <!-- The inset, rounded chrome is what makes the window look like it floats. Full
         screen has no desktop to float over, and a 6px margin there would only show the
         desktop through the edges. -->
    <Style Selector="Window:fullscreen Border#WindowChrome">
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
  </Window.Styles>

  <Design.DataContext>
    <vm:Main />
  </Design.DataContext>

  <Border x:Name="WindowChrome"
          Margin="6"
          Background="{StaticResource Color.Window}"
          BorderBrush="#3A4059"
          BorderThickness="1"
          BoxShadow="0 6 22 0 #7A000000"
          ClipToBounds="True"
          CornerRadius="12">
    <!-- Everything is laid out at the size the design was drawn for and then scaled, so
         full screen makes the whole interface bigger rather than leaving it the same
         pixel size in the middle of a much larger window. -->
    <LayoutTransformControl x:Name="UiScaler"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
    <Grid x:Name="ContentRoot" RowDefinitions="30,*">

      <!-- Title Bar -->
      <Grid Grid.Row="0"
            Name="TitleBar"
            Background="{StaticResource Color.Contents}"
            PointerPressed="OnTitleBarPressed">

        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource FontDefault}"
                   FontSize="13"
                   Foreground="#C8CBD6"
                   Text="{StaticResource Text.Title}" />

        <StackPanel Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
          <Button Classes="caption" Click="OnMinimise" ToolTip.Tip="Minimise">
            <Rectangle Width="10" Height="2" Fill="White" />
          </Button>
          <Button Classes="caption"
                  Click="OnToggleFullScreen"
                  ToolTip.Tip="Full screen (F11)">
            <Rectangle Width="9"
                       Height="9"
                       Stroke="White"
                       StrokeThickness="1.5" />
          </Button>
          <Button Classes="caption close" Click="OnClose" ToolTip.Tip="Close">
            <TextBlock Margin="0,-1,0,0"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="White"
                       Text="X" />
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="0,*">

        <!-- Artwork.
             Two layers that cross-fade. The timer points whichever one is invisible at the
             next picture and then swaps the two opacities; the transition below does the
             fade, so both the outgoing and incoming halves are one assignment each. -->
        <Image x:Name="BackdropA"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               Classes="backdrop"
               Source="/Assets/background.png"
               Stretch="UniformToFill" />

        <Image x:Name="BackdropB"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               Classes="backdrop"
               Opacity="0"
               Stretch="UniformToFill" />

        <!-- Just enough shade at the bottom for the card to read -->
        <Border Grid.Column="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
              <GradientStop Offset="0.0" Color="#00000000" />
              <GradientStop Offset="0.55" Color="#1A05070E" />
              <GradientStop Offset="1.0" Color="#8C05070E" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <!-- Server Rail.
             Hidden until the pointer reaches the left edge, then it slides out over the
             artwork. Its column is zero wide, so nothing reserves space for it and the
             card beside it gets the whole window; the rail spans both columns and draws
             on top of them instead. -->
        <Panel Grid.Column="0"
               Grid.ColumnSpan="2"
               HorizontalAlignment="Left"
               Background="Transparent"
               Classes="railHost">

          <!-- The strip that opens it. Invisible, but it is what the pointer has to be
               inside; the host grows with the rail, so once open, staying on the rail
               keeps it open. -->
          <Border Width="16"
                  HorizontalAlignment="Left"
                  Background="Transparent" />

          <Border x:Name="ServerRail"
                  HorizontalAlignment="Left"
                  Background="{StaticResource Color.Server}"
                  ClipToBounds="True"
                  Classes="serverRail">

            <!-- Laid out at full width and clipped, so opening reveals the rail
                 rather than reflowing the text inside it. -->
            <DockPanel Width="330">

          <TextBlock Margin="16,12,16,8"
                     DockPanel.Dock="Top"
                     FontFamily="{StaticResource FontDefault}"
                     FontSize="11"
                     Foreground="{StaticResource Color.FG2}"
                     LetterSpacing="2"
                     Text="{StaticResource Text.Servers}" />

          <!-- Version -->
          <TextBlock Margin="0,0,0,8"
                     HorizontalAlignment="Center"
                     DockPanel.Dock="Bottom"
                     FontFamily="{StaticResource FontDefault}"
                     FontSize="11"
                     Foreground="{StaticResource Color.FG2}"
                     Text="{Binding VersionLabel, Mode=OneWay}" />

          <!-- Rail Buttons -->
          <StackPanel Margin="0,10,0,6"
                      HorizontalAlignment="Center"
                      DockPanel.Dock="Bottom"
                      Orientation="Horizontal"
                      Spacing="9">

            <Button Classes="rail"
                    Command="{Binding ShowAddServerCommand}"
                    ToolTip.Tip="{StaticResource Text.Main.AddServer}">
              <Path Width="12"
                    Height="12"
                    Data="{StaticResource Icons.Add}"
                    Stretch="Uniform" />
            </Button>

            <Button Classes="rail"
                    Command="{Binding ShowSettingsCommand}"
                    ToolTip.Tip="{StaticResource Text.Settings}">
              <Path Width="14"
                    Height="14"
                    Data="{StaticResource Icons.Settings}"
                    Stretch="Uniform" />
            </Button>

            <Button Classes="rail"
                    Command="{Binding OpenDiscordCommand}"
                    ToolTip.Tip="{StaticResource Text.Main.Discord.Tooltip}">
              <Path Width="14"
                    Height="14"
                    Data="{StaticResource Icons.Discord}"
                    Stretch="Uniform" />
            </Button>

            <Button Classes="rail"
                    Command="{Binding OpenLogsCommand}"
                    ToolTip.Tip="{StaticResource Text.Logs}">
              <Path Width="13"
                    Height="13"
                    Data="{StaticResource Icons.Logs}"
                    Stretch="Uniform" />
            </Button>

            <Button Classes="rail"
                    Command="{Binding CheckForUpdatesCommand}"
                    ToolTip.Tip="{StaticResource Text.Main.CheckingForUpdatesToolTip}">
              <Path Width="13"
                    Height="13"
                    Classes.rotating="{Binding CheckForUpdatesCommand.IsRunning}"
                    Data="{StaticResource Icons.Loading}"
                    Stretch="Uniform" />
            </Button>
          </StackPanel>

          <!-- Server List -->
          <ListBox Margin="4,0"
                   Background="Transparent"
                   ItemsSource="{Binding Servers, Mode=TwoWay}"
                   SelectedItem="{Binding ActiveServer, Mode=TwoWay}"
                   SelectionMode="Toggle">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:Server">
                <Grid Margin="0,5" ColumnDefinitions="Auto,*,Auto">

                  <Border Grid.Column="0"
                          Width="32"
                          Height="32"
                          Background="#2EFFFFFF"
                          CornerRadius="16">
                    <Image Width="21"
                           Height="21"
                           Source="/Assets/logo.png"
                           Stretch="Uniform" />
                  </Border>

                  <StackPanel Grid.Column="1"
                              Margin="9,0,6,0"
                              VerticalAlignment="Center"
                              Orientation="Vertical">
                    <TextBlock FontFamily="{StaticResource FontDefault}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Color.FG1}"
                               Text="{Binding Info.Name, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <TextBlock FontFamily="{StaticResource FontDefault}"
                               FontSize="11"
                               Foreground="{StaticResource Color.FG2}"
                               Text="{Binding Subtitle, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                  </StackPanel>

                  <StackPanel Grid.Column="2"
                              VerticalAlignment="Center"
                              Orientation="Vertical"
                              Spacing="4">

                    <Button Width="22"
                            Height="22"
                            HorizontalAlignment="Right"
                            Classes="rail small"
                            ToolTip.Tip="{StaticResource Text.Server.Options.Tooltip}">
                      <Path Width="10"
                            Height="10"
                            Data="{StaticResource Icons.Edit}"
                            Stretch="Uniform" />
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Command="{Binding RefreshCommand}" Header="{StaticResource Text.Refresh}" />
                          <MenuItem Command="{Binding OpenFolderCommand}" Header="{StaticResource Text.Server.ClientFolder.Tooltip}" />
                          <MenuItem Command="{Binding ToggleNewsCommand}" Header="{StaticResource Text.Server.News}" />
                          <Separator />
                          <MenuItem Command="{Binding $parent[Window].((vm:Main)DataContext).DeleteServerCommand}" Header="{StaticResource Text.Delete_Server}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>

                    <Ellipse Width="9"
                             Height="9"
                             HorizontalAlignment="Center"
                             Fill="{Binding ServerStatusFill}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="8,1" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{StaticResource Color.Rail.ItemSelected}" />
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{StaticResource Color.Rail.ItemHover}" />
                <Setter Property="Cursor" Value="Hand" />
              </Style>
            </ListBox.Styles>
          </ListBox>
            </DockPanel>
          </Border>
        </Panel>

        <!-- Hero.
             The spacer tracks the rail's live width, so everything here re-centres in
             whatever room is left rather than being cut into when the rail opens - the
             welcome card sat at 240..780 and the rail reached 330. It follows the width
             animation for free, because that is what it is bound to. -->
        <Grid Grid.Column="1" ColumnDefinitions="Auto,*">

          <Border Width="{Binding #ServerRail.Bounds.Width}" IsHitTestVisible="False" />

          <Grid Grid.Column="1" RowDefinitions="Auto,*">

          <Image Grid.Row="0"
                 Width="330"
                 Margin="0,10,0,0"
                 HorizontalAlignment="Center"
                 Source="/Assets/wordmark.png"
                 Stretch="Uniform" />

          <TextBlock Grid.Row="1"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontFamily="{StaticResource FontDefault}"
                     FontSize="14"
                     Foreground="{StaticResource Color.FG1}"
                     IsVisible="{Binding ActiveServer, Converter={x:Static ObjectConverters.IsNull}}"
                     Text="{StaticResource Text.Main.NoServer}" />

          <TextBlock Grid.Row="1"
                     Margin="20,0,20,10"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     FontFamily="{StaticResource FontDefault}"
                     FontSize="13"
                     Foreground="{StaticResource Color.FG1}"
                     IsVisible="{Binding ActiveServer, Converter={x:Static ObjectConverters.IsNull}}"
                     Text="{Binding Message, Mode=OneWay}"
                     TextWrapping="Wrap" />

          <v:Server Grid.Row="1"
                    DataContext="{Binding ActiveServer, Mode=TwoWay}"
                    IsVisible="{Binding $parent[Window].((vm:Main)DataContext).ActiveServer, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </Grid>
        </Grid>

        <!-- Popups -->
        <Grid Grid.Column="0"
              Grid.ColumnSpan="2"
              IsVisible="{Binding Popup, Converter={x:Static ObjectConverters.IsNotNull}}">

          <Border Background="#000000" Opacity="0.55" />

          <Grid MinWidth="500"
              MaxWidth="840"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <ContentControl ClipToBounds="False" Content="{Binding Popup}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:Popup">
                  <Border Margin="8,0,8,8"
                          Background="{StaticResource Color.Popup}"
                          BorderBrush="{StaticResource Color.Border}"
                          BorderThickness="1"
                          CornerRadius="10">
                    <StackPanel Margin="8" Orientation="Vertical">

                      <ContentPresenter Margin="0,8"
                                        Content="{Binding View}"
                                        IsHitTestVisible="{Binding InProgress, Converter={x:Static BoolConverters.Not}}" />

                      <StackPanel IsVisible="{Binding InProgress}" Orientation="Vertical">
                        <Rectangle Height="1" HorizontalAlignment="Stretch" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="{StaticResource FontDefault}"
                                   FontStyle="Italic"
                                   Text="{Binding ProgressDescription, Mode=OneWay}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
          </Grid>
        </Grid>

        <!-- Notifications -->
        <Grid Grid.Column="0"
              Grid.ColumnSpan="2"
              Width="400"
              Margin="0,10,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Top">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Notifications}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:Notification">
                  <Grid Margin="0,15,0,0">
                    <Border Background="{StaticResource Color.Popup}"
                            BorderBrush="{StaticResource Color.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Opacity="0.95" />
                    <Grid Margin="10" RowDefinitions="20,Auto,15">

                      <StackPanel Grid.Row="0"
                                  HorizontalAlignment="Center"
                                  IsVisible="{Binding IsError}"
                                  Orientation="Horizontal">
                        <Image HorizontalAlignment="Left" Source="/Assets/fr_asset2.png" Stretch="None" />
                        <TextBlock Margin="5,0,0,0"
                                   FontFamily="{StaticResource FontDefault}"
                                   FontSize="15"
                                   Text="{StaticResource Text.Main.Error}" />
                      </StackPanel>

                      <StackPanel Grid.Row="0"
                                  HorizontalAlignment="Center"
                                  IsVisible="{Binding IsError, Converter={x:Static BoolConverters.Not}}"
                                  Orientation="Horizontal">
                        <Image HorizontalAlignment="Left" Source="/Assets/fr_asset2.png" Stretch="None" />
                        <TextBlock Margin="5,0,0,0"
                                   FontFamily="{StaticResource FontDefault}"
                                   FontSize="15"
                                   Text="{StaticResource Text.Main.Info}" />
                      </StackPanel>

                      <TextBox Grid.Row="1"
                               MaxHeight="200"
                               Margin="8"
                               Padding="3"
                               VerticalContentAlignment="Top"
                               Classes="no_background no_border"
                               FontSize="13"
                               IsReadOnly="True"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"
                               Text="{Binding Message, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
    </LayoutTransformControl>
  </Border>
</Window>
